# Keep the build context small and free of host-specific junk.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.github/

# Data and the Chroma index are bind-mounted at runtime, never baked in.
data/

# Secrets never enter an image — the API reads .env via env_file at runtime
# and authenticates to GCP through the mounted ADC file.
.env
.env.local

# Not needed by the API image.
frontend/node_modules/
frontend/dist/
dbt/target/
dbt/logs/
dbt/dbt_packages/
docs/
tests/
