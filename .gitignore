.venv/
# Isolated venv holding apache-airflow only for the DAG structure import test
# (kept out of the shared mainline .venv — see docs/learn/faza-6-airflow.md).
.venv-airflow/
__pycache__/
*.pyc
.env
.env.local
# GCP credentials — NEVER in repo
# We use Application Default Credentials (ADC), not key files, but block any
# service-account key that might be downloaded so it can never be committed.
gcp_key.json
*-key.json
*-sa.json
*service-account*.json
credentials.json
# Data (we don't version Parquet files)
data/
*.parquet
# IDE
.vscode/
.idea/
.DS_Store
# dbt artifacts
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
